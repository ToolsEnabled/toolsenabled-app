{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.toolsenabled.local/data/schema/agents.schema.json",
  "title": "ToolsEnabled agent-detail projection v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "domain", "generatedAt", "ok", "reason", "sources", "data"],
  "properties": {
    "schemaVersion": { "const": 1 }, "domain": { "const": "agents" },
    "generatedAt": { "type": "string", "format": "date-time" }, "ok": { "type": "boolean" },
    "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
    "sources": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/source" } },
    "data": { "anyOf": [{ "$ref": "#/$defs/data" }, { "type": "null" }] }
  },
  "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "data": { "$ref": "#/$defs/data" } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "data": { "type": "null" } } } }],
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "path", "ok", "observedAt", "reason"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" }, "kind": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" }, "path": { "type": "string", "minLength": 1, "maxLength": 240 }, "ok": { "type": "boolean" }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 } },
      "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 } } } }]
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "displayName", "role", "provider", "enabled", "assignedPhase", "phasePriority", "controlTarget"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "minLength": 1, "maxLength": 40 }, "provider": { "type": "string", "minLength": 1, "maxLength": 32 }, "enabled": { "type": "boolean" },
        "assignedPhase": { "type": ["string", "null"], "pattern": "^Q[0-9]{1,3}$" }, "phasePriority": { "type": "array", "maxItems": 128, "items": { "type": "string", "pattern": "^Q[0-9]{1,3}$" } },
        "controlTarget": { "anyOf": [{ "$ref": "#/$defs/controlTarget" }, { "type": "null" }] },
        "cloudLane": { "anyOf": [{ "$ref": "#/$defs/cloudLane" }, { "type": "null" }] },
        "bornAt": { "type": "integer", "minimum": 0 }, "stoppedAt": { "type": "integer", "minimum": 0 }, "origin": { "enum": ["user", "self"] },
        "tasksDone": { "type": "integer", "minimum": 0 }, "failRate": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "cloudLane": {
      "$comment": "The contract src/lane-marks.js reads to decide whether a node carries the swarm box or the drift light. It was absent here while the renderer already honoured it, so the first populated lane record would have failed validation before either mark could draw. Optional throughout: a node with no cloud lane carries no key, and nothing is drawn.",
      "type": "object", "additionalProperties": false,
      "required": ["running"],
      "properties": {
        "running": { "type": "boolean" },
        "tokens": { "type": "integer", "minimum": 0 },
        "drift": { "enum": ["drifting", "off-course"] }
      }
    },
    "controlTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["agentId", "runId", "pid", "status", "recordRevision", "startedAt", "lastHeartbeat"],
      "properties": {
        "agentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "runId": { "type": "string", "pattern": "^[a-f0-9-]{16,64}$" },
        "pid": { "type": ["integer", "null"], "minimum": 1 },
        "status": { "enum": ["starting", "running", "stale", "finished", "failed"] },
        "recordRevision": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "integer", "minimum": 0 },
        "lastHeartbeat": { "type": "integer", "minimum": 0 }
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "type", "sourceKind"],
      "properties": { "from": { "type": "string", "minLength": 1, "maxLength": 64 }, "to": { "type": "string", "minLength": 1, "maxLength": 64 }, "type": { "enum": ["manages", "reviews", "delegates_to", "escalates_to"] }, "sourceKind": { "enum": ["declared", "observed"] } }
    },
    "session": {
      "type": "object", "additionalProperties": false, "required": ["provider", "sessionId", "updatedAt"],
      "properties": { "provider": { "enum": ["codex", "claude"] }, "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9-]{8,80}$" }, "updatedAt": { "type": ["string", "null"], "format": "date-time" } }
    },
    "sessionObservation": {
      "type": "object", "additionalProperties": false, "required": ["ok", "reason", "observedAt", "value"],
      "properties": { "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "value": { "anyOf": [{ "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/session" } }, { "type": "null" }] } },
      "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "value": { "type": "array", "items": { "$ref": "#/$defs/session" } } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "value": { "type": "null" } } } }]
    },
    "data": {
      "type": "object", "additionalProperties": false, "required": ["revision", "contentHash", "declared", "relationships", "observedSessions"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 }, "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "declared": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/agent" } },
        "relationships": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/relationship" } },
        "observedSessions": { "$ref": "#/$defs/sessionObservation" }
      }
    }
  }
}
