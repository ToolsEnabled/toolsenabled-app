{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schema.toolsenabled.local/data/schema/coordinator.schema.json", "title": "ToolsEnabled coordinator-thread projection v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "domain", "generatedAt", "ok", "reason", "sources", "data"],
  "properties": { "schemaVersion": { "const": 1 }, "domain": { "const": "coordinator" }, "generatedAt": { "type": "string", "format": "date-time" }, "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "sources": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/source" } }, "data": { "anyOf": [{ "$ref": "#/$defs/data" }, { "type": "null" }] } },
  "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "data": { "$ref": "#/$defs/data" } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "data": { "type": "null" } } } }],
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "ok", "observedAt", "reason"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" }, "kind": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" }, "path": { "type": "string", "minLength": 1, "maxLength": 240 }, "ok": { "type": "boolean" }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 } } } }] },
    "identity": { "type": "object", "additionalProperties": false, "required": ["id", "displayName", "provider", "enabled"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 64 }, "displayName": { "type": "string", "minLength": 1, "maxLength": 80 }, "provider": { "type": "string", "minLength": 1, "maxLength": 32 }, "enabled": { "type": "boolean" } } },
    "session": { "type": "object", "additionalProperties": false, "required": ["sessionId", "updatedAt"], "properties": { "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9-]{8,80}$" }, "updatedAt": { "type": ["string", "null"], "format": "date-time" } } },
    "sessionsObservation": { "type": "object", "additionalProperties": false, "required": ["ok", "reason", "observedAt", "value"], "properties": { "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "value": { "anyOf": [{ "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/session" } }, { "type": "null" }] } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "value": { "type": "array", "items": { "$ref": "#/$defs/session" } } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "value": { "type": "null" } } } }] },
    "message": { "type": "object", "additionalProperties": false, "required": ["id", "sender", "at", "text", "contentTrust", "grantsAuthority"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 120 }, "sender": { "type": "string", "minLength": 1, "maxLength": 80 }, "at": { "type": "string", "format": "date-time" }, "text": { "type": "string", "maxLength": 4000 }, "contentTrust": { "const": "untrusted" }, "grantsAuthority": { "const": false } } },
    "threadObservation": { "type": "object", "additionalProperties": false, "required": ["ok", "reason", "observedAt", "value"], "properties": { "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "value": { "anyOf": [{ "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/message" } }, { "type": "null" }] } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "value": { "type": "array", "items": { "$ref": "#/$defs/message" } } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "value": { "type": "null" } } } }] },
    "data": { "type": "object", "additionalProperties": false, "required": ["identity", "sessions", "thread"], "properties": { "identity": { "$ref": "#/$defs/identity" }, "sessions": { "$ref": "#/$defs/sessionsObservation" }, "thread": { "$ref": "#/$defs/threadObservation" } } }
  }
}
