{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schema.toolsenabled.local/data/schema/ledger.schema.json", "title": "ToolsEnabled R/Q ledger projection v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "domain", "generatedAt", "ok", "reason", "sources", "data"],
  "properties": { "schemaVersion": { "const": 1 }, "domain": { "const": "ledger" }, "generatedAt": { "type": "string", "format": "date-time" }, "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "sources": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/source" } }, "data": { "anyOf": [{ "$ref": "#/$defs/data" }, { "type": "null" }] } },
  "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "data": { "$ref": "#/$defs/data" } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "data": { "type": "null" } } } }],
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "ok", "observedAt", "reason"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" }, "kind": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" }, "path": { "type": "string", "minLength": 1, "maxLength": 240 }, "ok": { "type": "boolean" }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 } } } }] },
    "request": { "type": "object", "additionalProperties": false, "required": ["id", "status", "gateCount", "unmetGateCount"], "properties": { "id": { "type": "string", "pattern": "^R[0-9]{1,4}(\\.[0-9]+)?$" }, "status": { "type": "string", "minLength": 1, "maxLength": 40 }, "gateCount": { "type": "integer", "minimum": 0 }, "unmetGateCount": { "type": "integer", "minimum": 0 } } },
    "question": { "type": "object", "additionalProperties": false, "required": ["id", "title", "status", "statusClass", "packageId"], "properties": { "id": { "type": "string", "pattern": "^Q[0-9]{1,3}$" }, "title": { "type": "string", "minLength": 1, "maxLength": 240 }, "status": { "type": "string", "minLength": 1, "maxLength": 120 }, "statusClass": { "enum": ["open", "in-progress", "blocked", "done", "unknown"] }, "packageId": { "type": ["string", "null"], "maxLength": 80 } } },
    "questionsObservation": { "type": "object", "additionalProperties": false, "required": ["ok", "reason", "observedAt", "value"], "properties": { "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "value": { "anyOf": [{ "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/question" } }, { "type": "null" }] } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "value": { "type": "array", "items": { "$ref": "#/$defs/question" } } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "value": { "type": "null" } } } }] },
    "data": { "type": "object", "additionalProperties": false, "required": ["requests", "questions"], "properties": { "requests": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/request" } }, "questions": { "$ref": "#/$defs/questionsObservation" } } }
  }
}
