{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schema.toolsenabled.local/data/schema/ops.schema.json", "title": "ToolsEnabled ops-channel projection v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "domain", "generatedAt", "ok", "reason", "sources", "data"],
  "properties": { "schemaVersion": { "const": 1 }, "domain": { "const": "ops" }, "generatedAt": { "type": "string", "format": "date-time" }, "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "sources": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/source" } }, "data": { "anyOf": [{ "$ref": "#/$defs/data" }, { "type": "null" }] } },
  "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "data": { "$ref": "#/$defs/data" } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "data": { "type": "null" } } } }],
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "ok", "observedAt", "reason"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" }, "kind": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" }, "path": { "type": "string", "minLength": 1, "maxLength": 240 }, "ok": { "type": "boolean" }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 } } } }] },
    "declaredService": { "type": "object", "additionalProperties": false, "required": ["id", "displayName", "transport", "port", "resolution"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 120 }, "transport": { "type": "string", "minLength": 1, "maxLength": 64 }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "resolution": { "enum": ["fixed", "peer", "self", "loopback"] } } },
    "channel": { "type": "object", "additionalProperties": false, "required": ["id", "name", "state", "observedAt", "detail"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "state": { "enum": ["healthy", "stale", "conflict", "unknown", "unavailable"] }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "detail": { "type": ["string", "null"], "maxLength": 240 } } },
    "channelsObservation": { "type": "object", "additionalProperties": false, "required": ["ok", "reason", "observedAt", "value"], "properties": { "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "value": { "anyOf": [{ "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/channel" } }, { "type": "null" }] } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "value": { "type": "array", "items": { "$ref": "#/$defs/channel" } } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "value": { "type": "null" } } } }] },
    "mcpValue": { "type": "object", "additionalProperties": false, "required": ["live", "dead"], "properties": { "live": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }, "dead": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 80 } } } },
    "mcpObservation": { "type": "object", "additionalProperties": false, "required": ["ok", "reason", "observedAt", "value"], "properties": { "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "value": { "anyOf": [{ "$ref": "#/$defs/mcpValue" }, { "type": "null" }] } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "value": { "$ref": "#/$defs/mcpValue" } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "value": { "type": "null" } } } }] },
    "message": { "type": "object", "additionalProperties": false, "required": ["id", "channelId", "sender", "at", "text", "contentTrust", "grantsAuthority"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 120 }, "channelId": { "type": "string", "minLength": 1, "maxLength": 80 }, "sender": { "type": "string", "minLength": 1, "maxLength": 80 }, "at": { "type": "string", "format": "date-time" }, "text": { "type": "string", "maxLength": 2000 }, "contentTrust": { "const": "untrusted" }, "grantsAuthority": { "const": false }, "kind": { "type": "string", "enum": ["ask", "answer", "notice"] }, "causalParent": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 } } },
    "messagesObservation": { "type": "object", "additionalProperties": false, "required": ["ok", "reason", "observedAt", "value"], "properties": { "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "value": { "anyOf": [{ "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/message" } }, { "type": "null" }] } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "value": { "type": "array", "items": { "$ref": "#/$defs/message" } } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "value": { "type": "null" } } } }] },
    "data": { "type": "object", "additionalProperties": false, "required": ["declaredServices", "channels", "mcp", "messages"], "properties": { "declaredServices": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/declaredService" } }, "channels": { "$ref": "#/$defs/channelsObservation" }, "mcp": { "$ref": "#/$defs/mcpObservation" }, "messages": { "$ref": "#/$defs/messagesObservation" } } }
  }
}
