{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schema.toolsenabled.local/data/schema/metrics.schema.json", "title": "ToolsEnabled metrics projection v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "domain", "generatedAt", "ok", "reason", "sources", "data"],
  "properties": { "schemaVersion": { "const": 1 }, "domain": { "const": "metrics" }, "generatedAt": { "type": "string", "format": "date-time" }, "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "sources": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/source" } }, "data": { "anyOf": [{ "$ref": "#/$defs/data" }, { "type": "null" }] } },
  "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "data": { "$ref": "#/$defs/data" } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "data": { "type": "null" } } } }],
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "ok", "observedAt", "reason"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" }, "kind": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" }, "path": { "type": "string", "minLength": 1, "maxLength": 240 }, "ok": { "type": "boolean" }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 } } } }] },
    "metricMap": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }, "maxProperties": 64 },
    "metricObservation": { "type": "object", "additionalProperties": false, "required": ["ok", "reason", "observedAt", "value"], "properties": { "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "value": { "anyOf": [{ "$ref": "#/$defs/metricMap" }, { "type": "null" }] } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "reason": { "type": "null" }, "value": { "$ref": "#/$defs/metricMap" } } }, "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "value": { "type": "null" } } } }] },
    "usageRow": { "type": "object", "additionalProperties": false, "required": ["pool", "provider", "role", "tokens", "calls", "tokenProvenance", "attributionProvenance"], "properties": { "pool": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$" }, "provider": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$" }, "role": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$" }, "tokens": { "type": "integer", "minimum": 0 }, "calls": { "type": "integer", "minimum": 0 }, "tokenProvenance": { "const": "MEASURED" }, "attributionProvenance": { "enum": ["MEASURED", "DERIVED"] } } },
    "usageValue": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "observation", "generatedAt", "source", "window", "coverage", "totals", "rows"], "properties": { "schemaVersion": { "const": 1 }, "observation": { "const": "agent-role-token-usage" }, "generatedAt": { "type": "string", "format": "date-time" }, "source": { "type": "object", "additionalProperties": false, "required": ["kind", "provenance", "requestedLimit"], "properties": { "kind": { "const": "signed-audit-tail" }, "provenance": { "const": "MEASURED" }, "requestedLimit": { "type": "integer", "minimum": 1, "maximum": 200 } } }, "window": { "type": "object", "additionalProperties": false, "required": ["scope", "earliestSequence", "latestSequence", "earliestTimestamp", "latestTimestamp"], "properties": { "scope": { "const": "latest-signed-event-tail" }, "earliestSequence": { "type": ["integer", "null"], "minimum": 0 }, "latestSequence": { "type": ["integer", "null"], "minimum": 0 }, "earliestTimestamp": { "type": ["string", "null"], "format": "date-time" }, "latestTimestamp": { "type": ["string", "null"], "format": "date-time" } } }, "coverage": { "type": "object", "additionalProperties": false, "required": ["state", "complete", "scannedEvents", "attributedUsageEvents", "excludedEvents"], "properties": { "state": { "enum": ["complete", "partial", "empty"] }, "complete": { "type": "boolean" }, "scannedEvents": { "type": "integer", "minimum": 0 }, "attributedUsageEvents": { "type": "integer", "minimum": 0 }, "excludedEvents": { "type": "object", "additionalProperties": false, "required": ["nonUsage", "overlapWrapper", "missingAttribution", "unknownAttribution", "invalidTokenAccounting", "invalidRouting"], "properties": { "nonUsage": { "type": "integer", "minimum": 0 }, "overlapWrapper": { "type": "integer", "minimum": 0 }, "missingAttribution": { "type": "integer", "minimum": 0 }, "unknownAttribution": { "type": "integer", "minimum": 0 }, "invalidTokenAccounting": { "type": "integer", "minimum": 0 }, "invalidRouting": { "type": "integer", "minimum": 0 } } } } }, "totals": { "type": "object", "additionalProperties": false, "required": ["tokens", "measuredLowerBoundTokens", "calls"], "properties": { "tokens": { "type": ["integer", "null"], "minimum": 0 }, "measuredLowerBoundTokens": { "type": "integer", "minimum": 0 }, "calls": { "type": "integer", "minimum": 0 } } }, "rows": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/usageRow" } } } },
    "usageAttributionObservation": { "type": "object", "additionalProperties": false, "required": ["ok", "state", "reason", "observedAt", "value"], "properties": { "ok": { "type": "boolean" }, "state": { "enum": ["complete", "empty", "partial", "unavailable"] }, "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }, "observedAt": { "type": ["string", "null"], "format": "date-time" }, "value": { "anyOf": [{ "$ref": "#/$defs/usageValue" }, { "type": "null" }] } }, "allOf": [{ "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "state": { "enum": ["complete", "empty", "partial"] }, "reason": { "type": "null" }, "value": { "$ref": "#/$defs/usageValue" } } }, "else": { "properties": { "state": { "const": "unavailable" }, "reason": { "type": "string", "minLength": 1 }, "value": { "type": "null" } } } }] },
    "data": { "type": "object", "additionalProperties": false, "required": ["sessions", "fleetSupervisor", "services", "requests", "queue", "audit", "memory", "usageAttribution"], "properties": { "sessions": { "$ref": "#/$defs/metricObservation" }, "fleetSupervisor": { "$ref": "#/$defs/metricObservation" }, "services": { "$ref": "#/$defs/metricObservation" }, "requests": { "$ref": "#/$defs/metricObservation" }, "queue": { "$ref": "#/$defs/metricObservation" }, "audit": { "$ref": "#/$defs/metricObservation" }, "memory": { "$ref": "#/$defs/metricObservation" }, "usageAttribution": { "$ref": "#/$defs/usageAttributionObservation" } } }
  }
}
