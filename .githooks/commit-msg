#!/bin/sh
# Refuse a commit that does not say who wrote it.
#
# WHY. In a repository where many agents and lanes commit under one shared git
# identity, the author field cannot distinguish a human from an agent, or one
# agent from another, so it is worthless for attribution. The commit message is
# the only place left to record who wrote a change.
#
# An unattributed commit cannot be attributed later -- the information is
# simply gone -- so this is a hook rather than another line of prose asking
# agents to add a trailer.
#
# THIS ONE BLOCKS, deliberately, unlike .githooks/post-commit and pre-push which
# are advisory on purpose. The reasoning differs: those two report on state that
# may be somebody else's and may be legitimately messy, so blocking would train
# people to bypass them. This asks only that you name yourself in your own
# commit message, the remedy is one line you are already writing, and an
# unattributed commit is not recoverable later.

msg_file="$1"
[ -z "$msg_file" ] && exit 0
[ -f "$msg_file" ] || exit 0

# Merges, reverts, squashes and fixups are generated by git itself.
case "$(head -n1 "$msg_file")" in
  "Merge "*|"Revert "*|"squash! "*|"fixup! "*|"amend! "*) exit 0 ;;
esac

# TWO TRAILERS ARE REQUIRED, and the second one is the load-bearing half.
#
# Co-Authored-By names the MODEL, never the actor: several lanes running the
# same model write an identical signature. A `Lane:` name alone is not unique
# either, because two seats doing the same work write the same lane name, and a
# parenthetical that describes the WORK has the same flaw. So `Lane:` must carry
# the literal token `session` plus an id of four or more characters.
#
# A SIGNATURE THAT CANNOT BE WRONG IS NOT A SIGNATURE.
#
# HONEST RESIDUAL: sub-agents of one session share its id, so this narrows the
# ambiguity without eliminating it. The trailer is a CLAIM -- this hook cannot
# verify it. But a claim that CAN be wrong is a signature; a label several seats
# emit identically is not.
has_author=$(grep -ci '^Co-Authored-By:[[:space:]]*[^[:space:]]' "$msg_file")
has_lane=$(grep -ci '^Lane:[[:space:]]*[^[:space:]]' "$msg_file")
has_seat=$(grep -ci '^Lane:.*(\(.*[[:space:],;]\)\?session[[:space:]]\+[A-Za-z0-9_-]\{4,\}' "$msg_file")

if [ "$has_author" -gt 0 ] && [ "$has_lane" -gt 0 ] && [ "$has_seat" -gt 0 ]; then
  exit 0
fi

cat >&2 <<'EOF'

  ============================================================
  [provenance] REFUSED: this commit does not say who wrote it.
  ============================================================
  In this repository many commits share one git author, so
  without a trailer this commit is permanently unattributable.

  Add BOTH lines at the end of your message:

    Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
    Lane: <your specific seat>

  BOTH are required, and Lane: is the one that matters.
  Co-Authored-By names your MODEL, and several lanes running the
  same model write an identical signature.

  Lane: must carry a SEAT DISCRIMINATOR in parentheses, because
  a lane NAME is not unique either. Use a session id, agent id,
  or worktree:

    Lane: dashboard (session 1a2b3c4)
    Lane: product-surface (session 5d6e7f80)
    Lane: installer/nsis (session 9a0b1c)

  The word "session" is REQUIRED. A parenthetical that
  describes the WORK -- "(settings read path S1-S4)" -- is
  REFUSED: two seats doing the same work write the same
  description.

  A human may use their own name for both.

  This hook blocks where the others only warn, because the
  remedy is two lines you are already writing, and an
  unattributed commit cannot be recovered after the fact.
  ============================================================

EOF
exit 1
